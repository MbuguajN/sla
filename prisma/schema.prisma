generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  name             String?
  email            String           @unique
  role             String           @default("EMPLOYEE")
  departmentId     Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastActiveAt     DateTime         @default(now())
  password         String?
  avatarUrl        String?
  auditLogs        AuditLog[]
  headedDepartment Department?      @relation("DepartmentHead")
  messages         Message[]
  notifications    Notification[]
  stories          Story[]
  reportedTasks    Task[]           @relation("ReportedTasks")
  assignedTasks    Task[]           @relation("AssignedTasks")
  department       Department?      @relation("DepartmentUsers", fields: [departmentId], references: [id])
  watchers         Watcher[]
  leaveRequests    LeaveRequest[]   @relation("UserLeaves")
  reviewedLeaves   LeaveRequest[]   @relation("LeaveReviewer")
  suggestions      Suggestion[]
  itRequests       ITSupportRequest[] @relation("ITRequestor")
  itAssigned       ITSupportRequest[] @relation("ITAssigned")
  itResolved       ITSupportRequest[] @relation("ITResolver")
  createdProjects    Project[]      @relation("ProjectCreator")
  createdSubProjects SubProject[]   @relation("SubProjectCreator")
  projectMemberships ProjectMember[]
  reviewerResponses  ReviewResponse[] @relation("ReviewerResponses")
  revieweeResponses  ReviewResponse[] @relation("RevieweeResponses")
  requisitions       Requisition[]    @relation("UserRequisitions")
  theme              String           @default("system")

  @@index([departmentId])
}

model Department {
  id     Int    @id @default(autoincrement())
  name   String @unique
  headId Int?   @unique
  head   User?  @relation("DepartmentHead", fields: [headId], references: [id])
  users  User[] @relation("DepartmentUsers")
}

model Sla {
  id              Int       @id @default(autoincrement())
  name            String
  durationHrs     Int
  tier            String    @default("BRONZE")
  projectDefaults Project[] @relation("ProjectDefaultSla")
  tasks           Task[]
}

model Project {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  status       String       @default("ACTIVE")
  createdById  Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  defaultSlaId Int?
  messages     Message[]
  defaultSla   Sla?         @relation("ProjectDefaultSla", fields: [defaultSlaId], references: [id])
  tasks        Task[]
  subProjects  SubProject[]
  createdBy    User?        @relation("ProjectCreator", fields: [createdById], references: [id])
  members      ProjectMember[]
}

model SubProject {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  status       String       @default("ACTIVE")
  projectId    Int
  parentId     Int?
  createdById  Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       SubProject?  @relation("SubProjectTree", fields: [parentId], references: [id])
  children     SubProject[] @relation("SubProjectTree")
  createdBy    User         @relation("SubProjectCreator", fields: [createdById], references: [id])
  tasks        Task[]
  messages     Message[]

  @@index([projectId])
  @@index([parentId])
}

model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  status       String       @default("PENDING")
  slaId        Int?
  assigneeId   Int?
  departmentId Int?
  isTicket     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  dueAt        DateTime?
  completedAt  DateTime?
  startedAt    DateTime?
  parentTaskId Int?
  pauseReason  String?
  projectId    Int?
  subProjectId Int?
  reporterId   Int?
  senderEmail  String?
  senderName   String?
  attachments  Attachment[]
  auditLogs    AuditLog[]
  messages     Message[]
  sla          Sla?         @relation(fields: [slaId], references: [id])
  reporter     User?        @relation("ReportedTasks", fields: [reporterId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  subProject   SubProject?  @relation(fields: [subProjectId], references: [id])
  parentTask   Task?        @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[]       @relation("SubTasks")
  assignee     User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  watchers     Watcher[]

  @@index([status])
  @@index([assigneeId])
  @@index([projectId])
  @@index([subProjectId])
  @@index([departmentId])
  @@index([isTicket])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  name      String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model Watcher {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
}

model Message {
  id           Int          @id @default(autoincrement())
  taskId       Int?
  projectId    Int?
  subProjectId Int?
  authorId     Int
  content      String
  createdAt    DateTime     @default(now())

  task         Task?        @relation(fields: [taskId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  subProject   SubProject?  @relation(fields: [subProjectId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model Story {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  authorId  Int
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])
}

model SystemSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// ─── HR System Models ───

model LeaveRequest {
  id              Int       @id @default(autoincrement())
  userId          Int
  type            String    // ANNUAL, SICK, MATERNITY, PATERNITY
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, DENIED, CANCELLED, ENDED_EARLY
  reviewedBy      Int?
  reviewedAt      DateTime?
  reviewNote      String?
  cancelledAt     DateTime?
  cancelledReason String?
  endedEarlyAt    DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation("UserLeaves", fields: [userId], references: [id])
  reviewer        User?     @relation("LeaveReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
}

model Suggestion {
  id        Int      @id @default(autoincrement())
  userId    Int
  category  String   // COMPLAINT, REQUEST, SUGGESTION, FEEDBACK
  content   String
  status    String   @default("OPEN") // OPEN, REVIEWED, RESOLVED
  adminNote String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([status])
}

model ITSupportRequest {
  id           Int       @id @default(autoincrement())
  userId       Int
  title        String
  description  String
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status       String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  assignedToId Int?
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("ITRequestor", fields: [userId], references: [id])
  assignedTo   User?     @relation("ITAssigned", fields: [assignedToId], references: [id])
  resolvedBy   User?     @relation("ITResolver", fields: [resolvedById], references: [id])

  @@index([userId])
  @@index([status])
}

// ─── Leave Policy ───

model LeavePolicy {
  id             Int    @id @default(autoincrement())
  roleCategory   String @unique  // "CEO", "MANAGER", "EMPLOYEE"
  annualDays     Int    @default(21)
  sickDays       Int    @default(10)
  maternityDays  Int    @default(90)
  paternityDays  Int    @default(14)
}

// ─── Performance Review System ───

model ReviewCycle {
  id          Int              @id @default(autoincrement())
  title       String
  status      String           @default("ACTIVE") // ACTIVE, CLOSED
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  questions   ReviewQuestion[]
  responses   ReviewResponse[]
}

model ReviewQuestion {
  id          Int              @id @default(autoincrement())
  cycleId     Int
  text        String
  targetType  String           // "EMPLOYEE" (manager rates employee), "MANAGER" (employee rates manager)
  cycle       ReviewCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  responses   ReviewResponse[]

  @@index([cycleId])
}

model ReviewResponse {
  id          Int            @id @default(autoincrement())
  cycleId     Int
  questionId  Int
  reviewerId  Int            // Who is rating
  revieweeId  Int            // Who is being rated
  rating      Int            // 1-10
  createdAt   DateTime       @default(now())
  reviewer    User           @relation("ReviewerResponses", fields: [reviewerId], references: [id])
  reviewee    User           @relation("RevieweeResponses", fields: [revieweeId], references: [id])
  cycle       ReviewCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  question    ReviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([cycleId, questionId, reviewerId, revieweeId])
  @@index([cycleId])
  @@index([reviewerId])
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String   @default("MEMBER") // MEMBER, INVITED
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Requisition {
  id          Int               @id @default(autoincrement())
  userId      Int
  status      String            @default("PENDING")
  reason      String?
  totalAmount Float             @default(0)
  reviewNote  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation("UserRequisitions", fields: [userId], references: [id])
  items       RequisitionItem[]
  @@index([userId])
  @@index([status])
}

model RequisitionItem {
  id            Int         @id @default(autoincrement())
  requisitionId Int
  itemName      String
  quantity      Int
  unitPrice     Float
  vatInclusive  Boolean     @default(false)
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  @@index([requisitionId])
}

