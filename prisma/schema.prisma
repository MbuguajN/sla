generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== USERS & AUTH ==============
model User {
  id                    Int         @id @default(autoincrement())
  email                 String      @unique
  password              String
  name                  String
  role                  Role
  department            Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  departmentId          Int?
  isActive              Boolean     @default(true)
  currentSessionId      String? // Tracks the only allowed active session
  authVersion           Int         @default(0) // Used for global logout
  passwordSetupRequired Boolean     @default(false) // True only for invited new users who still need to set a password
  firstLoginAt          DateTime? // Null = user must set password on first login
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  tasksCreated             Task[]                @relation("TaskCreator")
  tasksAssigned            Task[]                @relation("TaskAssignee")
  departmentHead           Department[]          @relation("DepartmentHead")
  activityLogs             ActivityLog[]
  leaves                   Leave[]
  suggestions              Suggestion[]
  requisitions             Requisition[]
  refunds                  Refund[]
  itTicketsCreated         ITTicket[]            @relation("TicketCreator")
  itTicketsAssigned        ITTicket[]            @relation("TicketAssignee")
  notifications            Notification[]
  loginAttempts            LoginAttempt[]
  leaveHandoversAsOriginal LeaveTaskHandover[]   @relation("LeaveHandoverOriginalAssignee")
  leaveHandoversAsDelegate LeaveTaskHandover[]   @relation("LeaveHandoverDelegate")
  equipmentOwned           EquipmentItem[]       @relation("EquipmentOwner")
  equipmentViewAccess      EquipmentViewer[]     @relation("EquipmentViewerUser")
  equipmentViewerGrants    EquipmentViewer[]     @relation("EquipmentViewerGrantedBy")
  boardColumns             PersonalBoardColumn[]
  boardCardsOwned          PersonalBoardCard[]   @relation("BoardCardOwner")
  boardCardsAssignedBy     PersonalBoardCard[]   @relation("BoardCardAssignedBy")
  heldPrivileges           UserPrivilege[]       @relation("HeldPrivileges")
  grantedPrivileges        UserPrivilege[]       @relation("GrantedPrivileges")
  UserInviteToken          UserInviteToken?
}

enum Role {
  ADMIN
  CEO
  MANAGER
  EMPLOYEE
}

enum Privilege {
  CAN_CREATE_CLIENTS
  CAN_CREATE_PROJECTS
  CAN_CREATE_TASKS
}

model UserPrivilege {
  id          Int       @id @default(autoincrement())
  user        User      @relation("HeldPrivileges", fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  privilege   Privilege
  grantedBy   User      @relation("GrantedPrivileges", fields: [grantedById], references: [id], onDelete: Cascade)
  grantedById Int
  grantedAt   DateTime  @default(now())

  @@unique([userId, privilege])
  @@index([userId])
  @@index([grantedById])
}

model LoginAttempt {
  id            Int                @id @default(autoincrement())
  email         String
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        Int?
  status        LoginAttemptStatus
  ipAddress     String?
  location      String?
  userAgent     String?
  failureReason String?
  createdAt     DateTime           @default(now())

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum LoginAttemptStatus {
  SUCCESS
  FAILED
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique // hashed token
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model UserInviteToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int       @unique
  email     String
  token     String    @unique // hashed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ============== DEPARTMENTS ==============
model Department {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  slug      String              @unique
  head      User?               @relation("DepartmentHead", fields: [headId], references: [id])
  headId    Int?                @unique
  members   User[]              @relation("DepartmentMembers")
  projects  ProjectDepartment[]
  tasks     Task[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ============== CLIENTS ==============
model Client {
  id          Int                 @id @default(autoincrement())
  name        String
  contactName String?
  email       String?
  phone       String?
  description String?
  status      ClientStatus        @default(ACTIVE)
  projects    Project[]
  boardCards  PersonalBoardCard[]
  createdBy   Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum ClientStatus {
  ACTIVE
  CLOSED
}

// ============== PROJECTS ==============
model Project {
  id          Int                 @id @default(autoincrement())
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    Int
  title       String
  description String?
  briefLink   String?
  briefLinks  ProjectLink[]
  status      ProjectStatus       @default(ACTIVE)
  createdBy   Int?
  departments ProjectDepartment[]
  tasks       Task[]
  boardCards  PersonalBoardCard[]
  activityLog ActivityLog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProjectLink {
  id        Int      @id @default(autoincrement())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  url       String
  createdAt DateTime @default(now())

  @@index([projectId])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProjectDepartment {
  id           Int        @id @default(autoincrement())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int
  slaHours     Int        @default(48)
  createdAt    DateTime   @default(now())

  @@unique([projectId, departmentId])
}

// ============== TASKS ==============
model Task {
  id                 Int                 @id @default(autoincrement())
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          Int
  title              String
  description        String?
  source             TaskSource          @default(STANDARD)
  status             TaskStatus          @default(UNASSIGNED)
  priority           Priority            @default(MEDIUM)
  assignedDepartment Department?         @relation(fields: [deptId], references: [id])
  deptId             Int?
  assignedTo         User?               @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  assignedUserId     Int?
  createdBy          User                @relation("TaskCreator", fields: [createdById], references: [id])
  createdById        Int
  slaHours           Int?
  briefReceivedAt    DateTime?
  briefCategory      BriefCategory?
  slaStartedAt       DateTime?
  startedAt          DateTime?
  slaPausedAt        DateTime?
  slaPausedDuration  Int?                @default(0)
  confirmedAt        DateTime?
  submittedAt        DateTime?
  completedAt        DateTime?
  subtasks           Subtask[]
  links              TaskLink[]
  activityLog        ActivityLog[]
  leaveHandovers     LeaveTaskHandover[]
  boardCard          PersonalBoardCard?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([assignedUserId])
  @@index([deptId])
  @@index([projectId])
}

enum TaskSource {
  STANDARD
  SELF_BOARD
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  CONFIRMED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  REVISION
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BriefCategory {
  SAFE
  SAT
}

// ============== TASK LINKS ==============
model TaskLink {
  id        Int      @id @default(autoincrement())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  name      String
  url       String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model PersonalBoardColumn {
  id               Int                 @id @default(autoincrement())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  title            String
  code             String
  kind             BoardColumnKind
  mappedTaskStatus TaskStatus
  position         Int                 @default(0)
  cards            PersonalBoardCard[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([userId, code])
  @@index([userId, position])
}

enum BoardColumnKind {
  TODO
  IN_PROGRESS
  DONE
  CUSTOM
}

model PersonalBoardCard {
  id              Int                 @id @default(autoincrement())
  owner           User                @relation("BoardCardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         Int
  assignedBy      User?               @relation("BoardCardAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById    Int?
  column          PersonalBoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId        Int
  task            Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          Int                 @unique
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       Int
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        Int
  title           String
  description     String?
  position        Int                 @default(0)
  enteredColumnAt DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([ownerId, columnId, position])
}

// ============== SUBTASKS ==============
model Subtask {
  id          Int           @id @default(autoincrement())
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      Int
  title       String
  description String?
  status      SubtaskStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum SubtaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// ============== ACTIVITY LOGS ==============
model ActivityLog {
  id                    Int          @id @default(autoincrement())
  type                  ActivityType
  description           String
  task                  Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId                Int?
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId             Int?
  user                  User         @relation(fields: [userId], references: [id])
  userId                Int
  metadata              String?      @default("{}")
  isHiddenFromDashboard Boolean      @default(false)
  createdAt             DateTime     @default(now())

  @@index([userId])
  @@index([taskId])
  @@index([projectId])
  @@index([createdAt])
}

enum ActivityType {
  CREATED
  ASSIGNED
  CONFIRMED
  STATUS_CHANGED
  COMMENTED
  ESCALATED
  SUBMITTED
  RESUMED
  PAUSED
  COMPLETED
}

// ============== HR - LEAVES ==============
model Leave {
  id         Int                 @id @default(autoincrement())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  totalDays  Float
  reason     String
  status     LeaveStatus         @default(PENDING)
  reviewedBy Int?
  reviewNote String?
  handovers  LeaveTaskHandover[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status])
}

enum LeaveType {
  LEAVE_FULL_DAY
  LEAVE_MORNING
  LEAVE_AFTERNOON
  SICKNESS_LEAVE_FULL_DAY
  SICKNESS_LEAVE_MORNING
  SICKNESS_LEAVE_AFTERNOON
  MATERNITY
  PATERNITY
  COMPASSIONATE_LEAVE
  TOIL
  WORK_FROM_HOME
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model LeaveTaskHandover {
  id                 Int            @id @default(autoincrement())
  leave              Leave          @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  leaveId            Int
  task               Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId             Int
  originalAssignee   User           @relation("LeaveHandoverOriginalAssignee", fields: [originalAssigneeId], references: [id], onDelete: Cascade)
  originalAssigneeId Int
  delegateUser       User           @relation("LeaveHandoverDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade)
  delegateUserId     Int
  status             HandoverStatus @default(PENDING_TRANSFER)
  transferredAt      DateTime?
  returnedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([leaveId, taskId])
  @@index([status])
  @@index([leaveId, status])
  @@index([delegateUserId])
  @@index([originalAssigneeId])
}

enum HandoverStatus {
  PENDING_TRANSFER
  TRANSFERRED
  RETURNED
  NOT_NEEDED
}

// ============== HR - LEAVE POLICIES ==============
model LeavePolicy {
  id          Int       @id @default(autoincrement())
  role        Role
  leaveType   LeaveType
  daysAllowed Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([role, leaveType])
}

// ============== HR - PUBLIC HOLIDAYS ==============
model PublicHoliday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

// ============== HR - SUGGESTIONS ==============
model Suggestion {
  id          Int                @id @default(autoincrement())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  title       String
  content     String
  category    SuggestionCategory
  isAnonymous Boolean            @default(false)
  status      SuggestionStatus   @default(OPEN)
  hrNote      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
}

enum SuggestionCategory {
  COMPLAINT
  SUGGESTION
  FEEDBACK
  REQUEST
}

enum SuggestionStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  CLOSED
}

// ============== FINANCE - REQUISITIONS ==============
model Requisition {
  id          Int               @id @default(autoincrement())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  title       String
  reason      String
  totalAmount Float
  items       RequisitionItem[]
  status      RequisitionStatus @default(PENDING_FINANCE)
  managerNote String?
  financeNote String?
  ceoNote     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model RequisitionItem {
  id            Int         @id @default(autoincrement())
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  requisitionId Int
  itemName      String
  quantity      Int
  unitPrice     Float
  vatInclusive  Boolean     @default(false)
}

enum RequisitionStatus {
  PENDING_FINANCE
  PENDING_CEO
  APPROVED
  DENIED
}

// ============== FINANCE - REFUNDS ==============
model Refund {
  id          Int          @id @default(autoincrement())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  amount      Float
  reason      String
  status      RefundStatus @default(PENDING_FINANCE)
  financeNote String?
  ceoNote     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

enum RefundStatus {
  PENDING_FINANCE
  PENDING_CEO
  APPROVED
  DENIED
}

// ============== IT SUPPORT ==============
model ITTicket {
  id             Int              @id @default(autoincrement())
  user           User             @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  title          String
  description    String
  priority       ITTicketPriority @default(MEDIUM)
  status         ITTicketStatus   @default(OPEN)
  assignedTo     User?            @relation("TicketAssignee", fields: [assignedUserId], references: [id])
  assignedUserId Int?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

enum ITTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ITTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============== EQUIPMENT ==============
model EquipmentCategory {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     EquipmentItem[]
}

model EquipmentItem {
  id           Int               @id @default(autoincrement())
  category     EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   Int
  make         String
  model        String
  ownerUser    User?             @relation("EquipmentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerUserId  Int?
  ownerLabel   String            @default("5DM")
  status       EquipmentStatus   @default(IN_USE)
  serialNumber String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([categoryId])
  @@index([ownerUserId])
  @@index([status])
}

model EquipmentViewer {
  id          Int      @id @default(autoincrement())
  user        User     @relation("EquipmentViewerUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      Int      @unique
  grantedBy   User?    @relation("EquipmentViewerGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedById Int?
  createdAt   DateTime @default(now())

  @@index([grantedById])
}

enum EquipmentStatus {
  IN_USE
  NOT_IN_USE
  MAINTENANCE
  RETIRED
}

// ============== NOTIFICATIONS ==============
model Notification {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_CONFIRMED
  TASK_COMPLETED
  LEAVE_APPROVED
  LEAVE_DENIED
  REQUISITION_SUBMITTED
  REQUISITION_APPROVED
  REQUISITION_DENIED
  REQUISITION_UPDATED
  REFUND_SUBMITTED
  REFUND_APPROVED
  REFUND_DENIED
  IT_TICKET_ASSIGNED
  IT_TICKET_RESOLVED
}

// ============== SYSTEM SETTINGS ==============
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
