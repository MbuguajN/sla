generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== USERS & AUTH ==============
model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  password      String
  name          String
  role          Role
  department    Department?     @relation("DepartmentMembers", fields: [departmentId], references: [id])
  departmentId  Int?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  tasksCreated      Task[]          @relation("TaskCreator")
  tasksAssigned     Task[]          @relation("TaskAssignee")
  departmentHead    Department[]    @relation("DepartmentHead")
  activityLogs      ActivityLog[]
  leaves            Leave[]
  suggestions       Suggestion[]
  requisitions      Requisition[]
  refunds           Refund[]
  itTicketsCreated  ITTicket[]      @relation("TicketCreator")
  itTicketsAssigned ITTicket[]      @relation("TicketAssignee")
  notifications     Notification[]
}

enum Role {
  ADMIN
  CEO
  MANAGER
  EMPLOYEE
}

// ============== DEPARTMENTS ==============
model Department {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  slug          String    @unique
  head          User?     @relation("DepartmentHead", fields: [headId], references: [id])
  headId        Int?      @unique
  members       User[]    @relation("DepartmentMembers")
  projects      ProjectDepartment[]
  tasks         Task[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============== CLIENTS ==============
model Client {
  id            Int       @id @default(autoincrement())
  name          String
  contactName   String?
  email         String?
  phone         String?
  description   String?
  projects      Project[]
  createdBy     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============== PROJECTS ==============
model Project {
  id              Int       @id @default(autoincrement())
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        Int
  title           String
  description     String?
  briefLink       String?
  status          ProjectStatus @default(ACTIVE)
  createdBy       Int?
  departments     ProjectDepartment[]
  tasks           Task[]
  activityLog     ActivityLog[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProjectDepartment {
  id            Int       @id @default(autoincrement())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     Int
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  Int
  slaHours      Int       @default(48)
  createdAt     DateTime  @default(now())

  @@unique([projectId, departmentId])
}

// ============== TASKS ==============
model Task {
  id                  Int       @id @default(autoincrement())
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           Int
  title               String
  description         String?
  status              TaskStatus @default(UNASSIGNED)
  priority            Priority  @default(MEDIUM)
  assignedDepartment  Department? @relation(fields: [deptId], references: [id])
  deptId              Int?
  assignedTo          User?     @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  assignedUserId      Int?
  createdBy           User      @relation("TaskCreator", fields: [createdById], references: [id])
  createdById         Int
  slaHours            Int?
  slaStartedAt        DateTime?
  slaPausedAt         DateTime?
  slaPausedDuration   Int?      @default(0)
  confirmedAt         DateTime?
  submittedAt         DateTime?
  completedAt         DateTime?
  subtasks            Subtask[]
  links               TaskLink[]
  activityLog         ActivityLog[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([assignedUserId])
  @@index([deptId])
  @@index([projectId])
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  CONFIRMED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  REVISION
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============== TASK LINKS ==============
model TaskLink {
  id        Int      @id @default(autoincrement())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  name      String
  url       String
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ============== SUBTASKS ==============
model Subtask {
  id          Int           @id @default(autoincrement())
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      Int
  title       String
  description String?
  status      SubtaskStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum SubtaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// ============== ACTIVITY LOGS ==============
model ActivityLog {
  id          Int         @id @default(autoincrement())
  type        ActivityType
  description String
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      Int?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int?
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
  metadata    String?     @default("{}")
  isHiddenFromDashboard Boolean @default(false)
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([taskId])
  @@index([projectId])
  @@index([createdAt])
}

enum ActivityType {
  CREATED
  ASSIGNED
  CONFIRMED
  STATUS_CHANGED
  COMMENTED
  ESCALATED
  SUBMITTED
  RESUMED
  PAUSED
  COMPLETED
}

// ============== HR - LEAVES ==============
model Leave {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedBy   Int?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  COMPASSIONATE
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// ============== HR - LEAVE POLICIES ==============
model LeavePolicy {
  id          Int       @id @default(autoincrement())
  role        Role
  leaveType   LeaveType
  daysAllowed Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([role, leaveType])
}

// ============== HR - PUBLIC HOLIDAYS ==============
model PublicHoliday {
  id        Int       @id @default(autoincrement())
  name      String
  date      DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([date])
}

// ============== HR - SUGGESTIONS ==============
model Suggestion {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  title       String
  content     String
  category    SuggestionCategory
  isAnonymous Boolean   @default(false)
  status      SuggestionStatus @default(OPEN)
  hrNote      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

enum SuggestionCategory {
  COMPLAINT
  SUGGESTION
  FEEDBACK
  REQUEST
}

enum SuggestionStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  CLOSED
}

// ============== FINANCE - REQUISITIONS ==============
model Requisition {
  id            Int         @id @default(autoincrement())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  title         String
  reason        String
  totalAmount   Float
  items         RequisitionItem[]
  status        RequisitionStatus @default(PENDING_MANAGER)
  managerNote   String?
  financeNote   String?
  ceoNote       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
}

model RequisitionItem {
  id            Int         @id @default(autoincrement())
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  requisitionId Int
  itemName      String
  quantity      Int
  unitPrice     Float
  vatInclusive  Boolean     @default(false)
}

enum RequisitionStatus {
  PENDING_MANAGER
  PENDING_FINANCE
  PENDING_CEO
  APPROVED
  DENIED
}

// ============== FINANCE - REFUNDS ==============
model Refund {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  amount      Float
  reason      String
  status      RefundStatus @default(PENDING)
  financeNote String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

enum RefundStatus {
  PENDING
  APPROVED
  DENIED
}

// ============== IT SUPPORT ==============
model ITTicket {
  id             Int       @id @default(autoincrement())
  user           User      @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  title          String
  description    String
  priority       ITTicketPriority @default(MEDIUM)
  status         ITTicketStatus @default(OPEN)
  assignedTo     User?     @relation("TicketAssignee", fields: [assignedUserId], references: [id])
  assignedUserId Int?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

enum ITTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ITTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============== NOTIFICATIONS ==============
model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_CONFIRMED
  TASK_COMPLETED
  LEAVE_APPROVED
  LEAVE_DENIED
  REQUISITION_APPROVED
  REQUISITION_DENIED
  REQUISITION_UPDATED
  IT_TICKET_ASSIGNED
  IT_TICKET_RESOLVED
}

// ============== SYSTEM SETTINGS ==============
model SystemSetting {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
