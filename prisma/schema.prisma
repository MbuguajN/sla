model DailyLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @default(now())
  cardId    Int?
  checklistItemId Int?
  title     String
  type      String   @default("CARD_COMPLETED")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model PersonalDocument {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  url        String
  category   String   @default("General")
  accessLevel String  @default("Restricted")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PlatformLink {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  favicon   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingRoom {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  location  String?
  isActive  Boolean  @default(true)
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation(fields: [createdBy], references: [id])
  bookings  MeetingBooking[]
}

model MeetingBooking {
  id                Int       @id @default(autoincrement())
  roomId            Int
  bookedByUserId    Int
  title             String
  startTime         DateTime
  endTime           DateTime
  isRecurring       Boolean   @default(false)
  recurrenceType    String?
  recurrenceEndDate DateTime?
  recurrenceGroupId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  room              MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookedBy          User        @relation(fields: [bookedByUserId], references: [id])

  @@index([roomId, startTime])
  @@index([bookedByUserId])
  @@index([recurrenceGroupId])
}

model PulseComment {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model UserLeaveOverride {
  id         Int      @id @default(autoincrement())
  userId     Int
  leaveType  LeaveType
  daysAllowed Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveType])
  @@index([userId])
}
