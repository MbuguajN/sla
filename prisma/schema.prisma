generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                     @id @default(autoincrement())
  email                     String                  @unique
  password                  String
  name                      String
  role                      Role
  departmentId              Int?
  isActive                  Boolean                 @default(true)
  currentSessionId          String?
  authVersion               Int                     @default(0)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  firstLoginAt              DateTime?
  passwordSetupRequired     Boolean                 @default(false)
  activityLogs              ActivityLog[]
  collectionBoardsOwned     CollectionBoard[]       @relation("CollectionBoardOwner")
  collectionBoardAccesses   CollectionBoardAccess[]
  collectionCardsAssignedBy CollectionBoardCard[]   @relation("CollectionCardAssignedBy")
  collectionBoardMembers    CollectionBoardMember[]
  departmentHead            Department?             @relation("DepartmentHead")
  equipmentOwned            EquipmentItem[]         @relation("EquipmentOwner")
  equipmentViewerGrants     EquipmentViewer[]       @relation("EquipmentViewerGrantedBy")
  equipmentViewAccess       EquipmentViewer?        @relation("EquipmentViewerUser")
  itTicketsAssigned         ITTicket[]              @relation("TicketAssignee")
  itTicketsCreated          ITTicket[]              @relation("TicketCreator")
  leaves                    Leave[]
  leaveHandoversAsDelegate  LeaveTaskHandover[]     @relation("LeaveHandoverDelegate")
  leaveHandoversAsOriginal  LeaveTaskHandover[]     @relation("LeaveHandoverOriginalAssignee")
  loginAttempts             LoginAttempt[]
  notifications             Notification[]
  boardCardsAssignedBy      PersonalBoardCard[]     @relation("BoardCardAssignedBy")
  boardCardsOwned           PersonalBoardCard[]     @relation("BoardCardOwner")
  boardColumns              PersonalBoardColumn[]
  refunds                   Refund[]
  requisitions              Requisition[]
  suggestions               Suggestion[]
  tasksAssigned             Task[]                  @relation("TaskAssignee")
  tasksCreated              Task[]                  @relation("TaskCreator")
  department                Department?             @relation("DepartmentMembers", fields: [departmentId], references: [id])
  UserInviteToken           UserInviteToken?
  grantedPrivileges         UserPrivilege[]         @relation("GrantedPrivileges")
  heldPrivileges            UserPrivilege[]         @relation("HeldPrivileges")
  workspacesOwned           Workspace[]             @relation("WorkspaceOwner")
  workspaceMembers          WorkspaceMember[]
  boardMembers              BoardMember[]
  boardListsCreated         BoardList[]
  boardChecklistAssignments BoardChecklistItem[]
  boardCardMembers          BoardCardMember[]
  boardCardsAssigned        BoardCard[]         @relation("BoardCardAssignee")
  dailyLogs                 DailyLog[]
  personalDocuments         PersonalDocument[]
  boardVisits               BoardVisit[]
  meetingRoomsCreated       MeetingRoom[]
  meetingBookings           MeetingBooking[]
  pulseComments             PulseComment[]
  leaveOverrides            UserLeaveOverride[]

  employmentDate            DateTime?
  maritalStatus             String?
  gender                    String?
  phoneNumber               String?
  address                   String?
  dateOfBirth               DateTime?
  emergencyContactName      String?
  emergencyContactPhone     String?
  emergencyContactRelation  String?
}

model Workspace {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  boards      Board[]
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  client      Client?

  @@index([ownerId])
}

model WorkspaceMember {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Board {
  id          Int              @id @default(autoincrement())
  workspaceId Int
  title       String
  background  String           @default("bg-sky-600")
  isStarred   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  visibility  BoardVisibility  @default(WORKSPACE)
  type        BoardType        @default(STANDALONE)
  projectId   Int?             @unique
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lists       BoardList[]
  members     BoardMember[]
  visits      BoardVisit[]

  @@index([workspaceId])
}

model BoardVisit {
  id        Int      @id @default(autoincrement())
  boardId   Int
  userId    Int
  visitedAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId, visitedAt(sort: Desc)])
}

model BoardMember {
  id        Int      @id @default(autoincrement())
  boardId   Int
  userId    Int
  role      String   @default("MEMBER")
  joinedAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model BoardList {
  id           Int         @id @default(autoincrement())
  boardId      Int
  title        String
  position     Int         @default(0)
  createdById  Int?
  isRestricted Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  cards        BoardCard[]
  board        Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy    User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([boardId, position])
}

model BoardCard {
  id            Int                   @id @default(autoincrement())
  listId        Int
  title         String
  description   String?
  position      Int                   @default(0)
  dueDate       DateTime?
  isCompleted   Boolean               @default(false)
  includeInLogs Boolean               @default(true)
  assignedToUserId Int?
  taskId        Int?                  @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  list        BoardList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignedUser User?                 @relation("BoardCardAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  task        Task?                 @relation("BoardCardTask")
  labels      BoardCardLabel[]
  members     BoardCardMember[]
  checklists  BoardChecklist[]
  attachments BoardCardAttachment[]
  activity    BoardCardActivity[]

  @@index([listId, position])
}

model BoardCardLabel {
  id        Int       @id @default(autoincrement())
  cardId    Int
  name      String
  color     String
  createdAt DateTime  @default(now())
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model BoardCardMember {
  id        Int       @id @default(autoincrement())
  cardId    Int
  userId    Int
  createdAt DateTime  @default(now())
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

model BoardChecklist {
  id        Int                  @id @default(autoincrement())
  cardId    Int
  title     String
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  card      BoardCard            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items     BoardChecklistItem[]

  @@index([cardId])
}

model BoardChecklistItem {
  id               Int             @id @default(autoincrement())
  checklistId      Int
  title            String
  isDone           Boolean         @default(false)
  assignedUserId   Int?
  position         Int             @default(0)
  subtaskId        Int?            @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  checklist        BoardChecklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignedUser     User?           @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  subtask          Subtask?        @relation("ChecklistItemSubtask")

  @@index([checklistId])
}

model BoardCardAttachment {
  id        Int      @id @default(autoincrement())
  cardId    Int
  name      String
  url       String
  createdAt DateTime @default(now())
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model BoardCardActivity {
  id          Int      @id @default(autoincrement())
  cardId      Int
  type        String
  actorName   String
  message     String
  createdAt   DateTime @default(now())
  card        BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model UserPrivilege {
  id          Int       @id @default(autoincrement())
  userId      Int
  privilege   Privilege
  grantedById Int
  grantedAt   DateTime  @default(now())
  grantedBy   User      @relation("GrantedPrivileges", fields: [grantedById], references: [id], onDelete: Cascade)
  user        User      @relation("HeldPrivileges", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, privilege])
  @@index([userId])
  @@index([grantedById])
}

model LoginAttempt {
  id            Int                @id @default(autoincrement())
  email         String
  userId        Int?
  status        LoginAttemptStatus
  ipAddress     String?
  location      String?
  userAgent     String?
  failureReason String?
  createdAt     DateTime           @default(now())
  user          User?              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model UserInviteToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model Department {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  slug      String              @unique
  headId    Int?                @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  head      User?               @relation("DepartmentHead", fields: [headId], references: [id])
  projects  ProjectDepartment[]
  tasks     Task[]
  members   User[]              @relation("DepartmentMembers")
}

model Client {
  id          Int                 @id @default(autoincrement())
  name        String
  contactName String?
  email       String?
  phone       String?
  description String?
  status      ClientStatus        @default(ACTIVE)
  createdBy   Int?
  workspaceId Int?                @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  boardCards  PersonalBoardCard[]
  projects    Project[]
  documents   ClientDocument[]
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}

model ClientDocument {
  id        Int      @id @default(autoincrement())
  clientId  Int
  name      String
  url       String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Project {
  id          Int                 @id @default(autoincrement())
  clientId    Int
  title       String
  description String?
  briefLink   String?
  status      ProjectStatus       @default(ACTIVE)
  createdBy   Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  activityLog ActivityLog[]
  boardCards  PersonalBoardCard[]
  boards      Board[]
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  departments ProjectDepartment[]
  briefLinks  ProjectLink[]
  tasks       Task[]
}

model ProjectLink {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  url       String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectDepartment {
  id           Int        @id @default(autoincrement())
  projectId    Int
  departmentId Int
  slaHours     Int        @default(48)
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, departmentId])
}

model Task {
  id                      Int                   @id @default(autoincrement())
  projectId               Int
  title                   String
  description             String?
  status                  TaskStatus            @default(UNASSIGNED)
  priority                Priority              @default(MEDIUM)
  deptId                  Int?
  assignedUserId          Int?
  createdById             Int?
  slaHours                Int?
  slaStartedAt            DateTime?
  startedAt               DateTime?
  slaPausedAt             DateTime?
  slaPausedDuration       Int?                  @default(0)
  confirmedAt             DateTime?
  submittedAt             DateTime?
  completedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  briefCategory           BriefCategory?
  briefReceivedAt         DateTime?
  source                  TaskSource            @default(STANDARD)
  workspaceBoardCardId    Int?                  @unique
  activityLog             ActivityLog[]
  collectionCards         CollectionBoardCard[]
  leaveHandovers          LeaveTaskHandover[]
  boardCard               PersonalBoardCard?
  workspaceBoardCard      BoardCard?            @relation("BoardCardTask", fields: [workspaceBoardCardId], references: [id], onDelete: SetNull)
  subtasks                Subtask[]
  assignedTo              User?                 @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  createdBy               User?                 @relation("TaskCreator", fields: [createdById], references: [id])
  assignedDepartment      Department?           @relation(fields: [deptId], references: [id])
  project                 Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links                   TaskLink[]

  @@index([status])
  @@index([assignedUserId])
  @@index([deptId])
  @@index([projectId])
}

model TaskLink {
  id        Int      @id @default(autoincrement())
  taskId    Int
  name      String
  url       String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model PersonalBoardColumn {
  id               Int                 @id @default(autoincrement())
  userId           Int
  title            String
  code             String
  kind             BoardColumnKind
  mappedTaskStatus TaskStatus
  position         Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cards            PersonalBoardCard[]
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, position])
}

model PersonalBoardCard {
  id              Int                 @id @default(autoincrement())
  ownerId         Int
  assignedById    Int?
  columnId        Int
  taskId          Int                 @unique
  projectId       Int
  clientId        Int
  title           String
  description     String?
  position        Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  enteredColumnAt DateTime            @default(now())
  assignedBy      User?               @relation("BoardCardAssignedBy", fields: [assignedById], references: [id])
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  column          PersonalBoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  owner           User                @relation("BoardCardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([ownerId, columnId, position])
}

model CollectionBoard {
  id          Int                     @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  owner       User                    @relation("CollectionBoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  accesses    CollectionBoardAccess[]
  cards       CollectionBoardCard[]
  columns     CollectionBoardColumn[]
  members     CollectionBoardMember[]

  @@index([ownerId])
  @@index([updatedAt])
}

model CollectionBoardMember {
  id         Int                  @id @default(autoincrement())
  boardId    Int
  userId     Int
  role       CollectionMemberRole @default(MEMBER)
  invitedAt  DateTime             @default(now())
  acceptedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  board      CollectionBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@index([boardId, role])
}

model CollectionBoardColumn {
  id               Int                   @id @default(autoincrement())
  boardId          Int
  title            String
  code             String
  kind             BoardColumnKind
  mappedTaskStatus TaskStatus
  position         Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  cards            CollectionBoardCard[]
  board            CollectionBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, code])
  @@index([boardId, position])
}

model CollectionBoardCard {
  id              Int                   @id @default(autoincrement())
  boardId         Int
  columnId        Int
  taskId          Int
  assignedById    Int?
  title           String
  description     String?
  position        Int                   @default(0)
  enteredColumnAt DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  assignedBy      User?                 @relation("CollectionCardAssignedBy", fields: [assignedById], references: [id])
  board           CollectionBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column          CollectionBoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  task            Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([boardId, taskId])
  @@index([boardId, columnId, position])
  @@index([taskId])
}

model CollectionBoardAccess {
  id             Int             @id @default(autoincrement())
  boardId        Int
  userId         Int
  lastAccessedAt DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  board          CollectionBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId, lastAccessedAt])
}

model Subtask {
  id               Int                    @id @default(autoincrement())
  taskId           Int
  title            String
  description      String?
  status           SubtaskStatus          @default(PENDING)
  checklistItemId  Int?                   @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  task             Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checklistItem    BoardChecklistItem?    @relation("ChecklistItemSubtask", fields: [checklistItemId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id                    Int          @id @default(autoincrement())
  type                  ActivityType
  description           String
  taskId                Int?
  projectId             Int?
  userId                Int?
  metadata              String?      @default("{}")
  isHiddenFromDashboard Boolean      @default(false)
  createdAt             DateTime     @default(now())
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                  Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                  User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([taskId])
  @@index([projectId])
  @@index([createdAt])
}

model Leave {
  id         Int                 @id @default(autoincrement())
  userId     Int
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  totalDays  Float
  reason     String
  status     LeaveStatus         @default(PENDING)
  reviewedBy Int?
  reviewNote String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  duration   LeaveDuration       @default(FULL_DAY)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  handovers  LeaveTaskHandover[]

  @@index([status])
}

model LeaveTaskHandover {
  id                 Int            @id @default(autoincrement())
  leaveId            Int
  taskId             Int
  originalAssigneeId Int
  delegateUserId     Int
  status             HandoverStatus @default(PENDING_TRANSFER)
  transferredAt      DateTime?
  returnedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  delegateUser       User           @relation("LeaveHandoverDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade)
  leave              Leave          @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  originalAssignee   User           @relation("LeaveHandoverOriginalAssignee", fields: [originalAssigneeId], references: [id], onDelete: Cascade)
  task               Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([leaveId, taskId])
  @@index([status])
  @@index([leaveId, status])
  @@index([delegateUserId])
  @@index([originalAssigneeId])
}

model LeavePolicy {
  id          Int       @id @default(autoincrement())
  role        Role
  leaveType   LeaveType
  daysAllowed Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([role, leaveType])
  @@unique([role, leaveType], map: "LeavePolicy_role_leaveType_unique_v2")
}

model PublicHoliday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Suggestion {
  id          Int                @id @default(autoincrement())
  userId      Int
  title       String
  content     String
  category    SuggestionCategory
  isAnonymous Boolean            @default(false)
  status      SuggestionStatus   @default(OPEN)
  hrNote      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Requisition {
  id          Int               @id @default(autoincrement())
  userId      Int
  title       String
  reason      String
  totalAmount Float
  status      RequisitionStatus @default(PENDING_FINANCE)
  managerNote String?
  financeNote String?
  ceoNote     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       RequisitionItem[]

  @@index([status])
}

model RequisitionItem {
  id            Int         @id @default(autoincrement())
  requisitionId Int
  itemName      String
  quantity      Int
  unitPrice     Float
  vatInclusive  Boolean     @default(false)
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
}

model Refund {
  id          Int          @id @default(autoincrement())
  userId      Int
  amount      Float
  reason      String
  status      RefundStatus @default(PENDING_FINANCE)
  financeNote String?
  ceoNote     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  receiptUrls String[]     @default([])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ITTicket {
  id             Int              @id @default(autoincrement())
  userId         Int
  title          String
  description    String
  priority       ITTicketPriority @default(MEDIUM)
  status         ITTicketStatus   @default(OPEN)
  assignedUserId Int?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignedTo     User?            @relation("TicketAssignee", fields: [assignedUserId], references: [id])
  user           User             @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model EquipmentCategory {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     EquipmentItem[]
}

model EquipmentItem {
  id           Int               @id @default(autoincrement())
  categoryId   Int
  make         String
  model        String
  ownerUserId  Int?
  ownerLabel   String            @default("5DM")
  status       EquipmentStatus   @default(IN_USE)
  serialNumber String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  category     EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ownerUser    User?             @relation("EquipmentOwner", fields: [ownerUserId], references: [id])

  @@index([categoryId])
  @@index([ownerUserId])
  @@index([status])
}

model EquipmentViewer {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  grantedById Int?
  createdAt   DateTime @default(now())
  grantedBy   User?    @relation("EquipmentViewerGrantedBy", fields: [grantedById], references: [id])
  user        User     @relation("EquipmentViewerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([grantedById])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

